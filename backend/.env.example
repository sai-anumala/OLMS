# Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Port to run the server on
PORT=8008

# MongoDB connection string (required)
# Local: mongodb://localhost:27017/librarydb
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
DB_URI=mongodb://localhost:27017/librarydb

# Secret used to sign login tokens (required)
# Generate one with: openssl rand -base64 32
SECRET=replace_with_a_long_random_string

# Frontend origin(s) allowed by CORS, comma-separated (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Optional: cookie domain when frontend and backend share a parent domain in production
# COOKIE_DOMAIN=.example.com

# Optional: Google Gemini API key for chatbot replies.
# Without it the chatbot still answers with a plain list of matching books.
# GEMINI_API_KEY=your_gemini_api_key
