# Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Port to run the server on
PORT=8008

# MongoDB connection string (required)
# Local: mongodb://localhost:27017/librarydb
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
DB_URI=mongodb://localhost:27017/librarydb

# Secret used to sign login tokens (required)
# Generate one with: openssl rand -base64 32
SECRET=replace_with_a_long_random_string

# Frontend URL(s) allowed to call this API, comma-separated.
# Trailing slashes and capital letters are fine. Example for production:
#   FRONTEND_URL=https://olms.online,https://www.olms.online
FRONTEND_URL=http://localhost:5173

# Set to "production" on your live server. When it is NOT production, any
# http://localhost / 127.0.0.1 port is also allowed so local development just works.
# NODE_ENV=production

# Optional: cookie domain when frontend and backend share a parent domain in production
# COOKIE_DOMAIN=.example.com

# Razorpay (fine payments). Test keys: dashboard.razorpay.com -> Account & Settings -> API Keys
# Never commit real keys; use test mode keys (rzp_test_...) while developing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: webhook secret (Dashboard -> Webhooks, events payment.captured and order.paid,
# URL https://<your-backend>/transaction-api/webhook). Finishes payments if the browser closes early.
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional: Google Gemini API key for chatbot replies.
# Without it the chatbot still answers with a plain list of matching books.
# GEMINI_API_KEY=your_gemini_api_key
